APP_NAME="QueueLess"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Connection (Default SQLite zero-config, or MySQL / PostgreSQL)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=queueless
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis Queue & State Engine (Optional fast cache / lock layer)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Multi-Channel Notification Configuration
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=

MAIL_MAILER=log
